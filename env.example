# Copy this file to .env and fill in your values
# cp env.example .env

# Resend email (required for emails to work: guest confirm/cancel, admin new-booking notification)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=Bookings <onboarding@resend.dev>

# Database (optional - defaults to sqlite in ./backend for local dev)
# For Docker, docker-compose sets this automatically
# DATABASE_URL=sqlite:////app/data/home_rental.db
